{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Neither the Worker nor its hostnames carry the Annict name (Art. 13 of the
  // Annict API Terms of Use). Renamed from "annict-mcp-server"; see README.
  "name": "anime-log-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  // The Annict OAuth application registers http://localhost:8000/callback as a
  // redirect URI, and the callback URL is derived from the request origin, so
  // `wrangler dev` must listen on 8000 rather than its default 8787.
  "dev": {
    "port": 8000
  },
  // The deployment of this repository. Replace the hostnames below with your
  // own (and drop "vars" unless you are moving a URL) before deploying.
  // Served only on its Custom Domains: a workers.dev URL would be a third,
  // unadvertised origin that is neither the new nor the old one.
  "workers_dev": false,
  "routes": [
    { "pattern": "anime-log-mcp.mokuichi147.com", "custom_domain": true },
    // The old URL stays attached until the move is complete, so its users are
    // pointed to the new one instead of being cut off (see migration.ts).
    { "pattern": "annict-mcp-server.mokuichi147.com", "custom_domain": true }
  ],
  "vars": {
    "CANONICAL_ORIGIN": "https://anime-log-mcp.mokuichi147.com",
    "LEGACY_ORIGINS": "https://annict-mcp-server.mokuichi147.com",
    "LEGACY_SUNSET": "2026-11-24T23:59:59+09:00"
  },
  // Stores OAuth grants, tokens and client registrations. Replace "id" with the
  // namespace created by `npx wrangler kv namespace create OAUTH_KV` before
  // deploying; `wrangler dev` simulates it locally regardless of the value.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "a17b58b871f94f20ae5bf0e475102bc1" }
  ],
  // MCP is stateless as of protocol revision 2026-07-28, so the Durable Object
  // that used to hold a session per client is gone. "v1" must stay listed for
  // the v2 deletion to apply to deployments that already ran it; a first-time
  // deployment applies both tags in order and ends up with no Durable Object.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnnictMcpAgent"] },
    { "tag": "v2", "deleted_classes": ["AnnictMcpAgent"] }
  ],
  "observability": {
    "enabled": true
  }
}
